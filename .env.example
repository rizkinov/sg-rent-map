NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required by the /api/cron/refresh-data endpoint (shared secret passed as ?secret=)
CRON_SECRET=your-cron-secret
# The cron refresh stays disabled unless this is 'true' (live URA fetch is not implemented yet)
ENABLE_URA_CRON=false

# Required by src/lib/utils/ura-token.ts when fetching live URA data
URA_ACCESS_KEY=your-ura-access-key
